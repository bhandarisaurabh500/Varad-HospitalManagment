# Backend Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eye_hospital
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=varad_netralaya_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# AI / OCR Provider
# Options: tesseract (free, local), google-vision, aws-textract, azure-cv
AI_PROVIDER=tesseract
AI_API_KEY=
AI_MODEL=

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# Upload limits
MAX_FILE_SIZE_MB=5
